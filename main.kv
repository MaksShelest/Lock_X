#:kivy 2.0.0


<CustomLabel@Label>:
    color: 1, 1, 1, 1
    halign: "left"
    valign: "middle"
    text_size: self.size


<CustomButton@Button>:
    background_color: 0, 0.39, 0.39, 1
    color: 1, 1, 1, 1
    font_size: "16sp"


<ConverterScreen@BoxLayout>:
    orientation: "vertical"
    padding: dp(12)
    spacing: dp(8)


    # ==============================
    # Заголовок
    # ==============================

    Label:
        text: "Lock_X"
        size_hint_y: None
        height: dp(45)
        font_size: "26sp"
        color: 1, 1, 1, 1

        canvas.before:
            Color:
                rgba: 0, 0.39, 0.39, 1
            Rectangle:
                pos: self.pos
                size: self.size


    # ==============================
    # Исходный текст
    # ==============================

    Label:
        text: "Исходное сообщение"
        size_hint_y: None
        height: dp(25)
        font_size: "16sp"
        color: 1, 1, 1, 1
        halign: "left"
        text_size: self.size


    TextInput:
        id: text_input
        hint_text: "Введите текст..."
        multiline: True
        font_size: "16sp"
        padding: dp(10), dp(10)


    # ==============================
    # Результат
    # ==============================

    Label:
        text: "Результат"
        size_hint_y: None
        height: dp(25)
        font_size: "16sp"
        color: 1, 1, 1, 1
        halign: "left"
        text_size: self.size


    TextInput:
        id: text_output
        hint_text: "Здесь появится результат..."
        multiline: True
        readonly: True
        font_size: "16sp"
        padding: dp(10), dp(10)


    # ==============================
    # Настройки
    # ==============================

    GridLayout:
        cols: 2
        size_hint_y: None
        height: dp(120)
        spacing: dp(8)

        Label:
            text: "Алгоритм:"
            color: 1, 1, 1, 1
            halign: "left"
            valign: "middle"
            text_size: self.size

        Spinner:
            id: algorithm_spinner
            text: "Цезарь"
            values: ["Цезарь", "Виженер", "Авторский"]
            font_size: "16sp"

            on_text: app.on_algorithm_changed(self.text)


        Label:
            text: "Режим:"
            color: 1, 1, 1, 1
            halign: "left"
            valign: "middle"
            text_size: self.size

        Spinner:
            id: mode_spinner
            text: "Шифрование"
            values: ["Шифрование", "Расшифрование"]
            font_size: "16sp"

            on_text: app.on_mode_changed(self.text)


        Label:
            text: "Ключ:"
            color: 1, 1, 1, 1
            halign: "left"
            valign: "middle"
            text_size: self.size

        TextInput:
            id: key_input
            hint_text: "Введите ключ"
            multiline: False
            font_size: "16sp"

            on_text: app.on_key_changed(self.text)


    # ==============================
    # Кнопка
    # ==============================

    CustomButton:
        text: "Зашифровать / расшифровать"
        size_hint_y: None
        height: dp(50)

        on_release: app.encrypt_or_decrypt()


# Корневой виджет приложения
ConverterScreen: